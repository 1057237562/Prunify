{
  "command": "git ls-files --others --exclude-standard",
  "version": 1,
  "rules": [
    {
      "action": "keep",
      "match_condition": {
        "type": "Regex",
        "pattern": ".*"
      },
      "description": "Keep all lines — output is already concise (untracked file paths)"
    }
  ]
}
