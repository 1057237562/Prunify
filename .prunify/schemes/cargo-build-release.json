{
  "command": "cargo build --release",
  "version": 1,
  "rules": [
    {
      "action": "discard",
      "match_condition": {
        "type": "Regex",
        "pattern": "^\\s{3}Compiling "
      },
      "description": "Discard compilation progress lines \u2014 cargo sends these to stderr, defensive rule for stdout"
    },
    {
      "action": "discard",
      "match_condition": {
        "type": "Regex",
        "pattern": "^\\s{4}Finished "
      },
      "description": "Discard build finished line \u2014 cargo sends this to stderr, defensive rule for stdout"
    },
    {
      "action": "discard",
      "match_condition": {
        "type": "Regex",
        "pattern": "^warning:"
      },
      "description": "Discard compiler warning headers (if they appear on stdout)"
    },
    {
      "action": "discard",
      "match_condition": {
        "type": "Regex",
        "pattern": "^\\s{3}= note:\\s.*(dead_code|unused|warnings|generated)"
      },
      "description": "Discard compiler notes about build warnings"
    }
  ]
}
